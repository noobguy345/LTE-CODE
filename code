#saha ionisation
CHI_FEI = 7.9024681 * EV_TO_ERG


def saha_fe(atm):

    T = atm["T_K"].values
    ne = atm["ne_cm3"].values

    U1 = U_FeI(T)
    U2 = U_FeII(T)

    saha_ratio = (
        (2.0 * U2 / U1) *
        (2.0 * np.pi * ME * KB * T / H**2)**1.5 *
        np.exp(
            -CHI_FEI / (KB * T)
        ) /
        ne
    )

    fe1_frac = 1.0 / (
        1.0 + saha_ratio
    )

    fe2_frac = saha_ratio / (
        1.0 + saha_ratio
    )

    out = atm.copy()

    out["FeII_FeI"] = saha_ratio
    out["FeI_fraction"] = fe1_frac
    out["FeII_fraction"] = fe2_frac

    return out


#boltzmann population
def lower_level_population(
    atm,
    species,
    excitation_cm1,
    g_lower
):

    T = atm["T_K"].values

    if species == "FeI":

        U = U_FeI(T)
        ion_fraction = atm["FeI_fraction"].values

    elif species == "FeII":

        U = U_FeII(T)
        ion_fraction = atm["FeII_fraction"].values

    else:

        raise ValueError(
            "species must be FeI or FeII"
        )

    feh_atm = atm.attrs.get(
        "FeH",
        CURRENT_FEH
    )

    n_fe_total = (
        atm["nH_cm3"].values *
        FE_H_SUN *
        10**feh_atm
    )

    n_ion = (
        n_fe_total *
        ion_fraction
    )

    E = (
        excitation_cm1 *
        H *
        C
    )

    n_lower = (
        n_ion *
        (g_lower / U) *
        np.exp(
            -E / (KB * T)
        )
    )

    return n_lower


#oscillator strength
def gf_to_f(gf, g_lower):
    return gf / g_lower


#thermal doppler width
def doppler_width(nu0, T):

    M_FE = (
        55.845 *
        1.66053906660e-24
    )

    return (
        nu0 / C *
        np.sqrt(
            2.0 *
            KB *
            T /
            M_FE
        )
    )


#gaussian profile
def gaussian_profile(
    nu,
    nu0,
    delta_nu
):

    return (
        1.0 /
        (
            delta_nu *
            np.sqrt(np.pi)
        )
    ) * np.exp(
        -((nu - nu0) / delta_nu)**2
    )


#line opacity
def line_opacity(
    atm,
    species,
    wavelength_nm,
    loggf,
    Ei_cm1,
    g_lower
):

    wavelength_cm = (
        wavelength_nm *
        1e-7
    )

    nu0 = C / wavelength_cm

    gf = 10**loggf
    f_lu = gf / g_lower

    n_lower = lower_level_population(
        atm,
        species,
        Ei_cm1,
        g_lower
    )

    T = atm["T_K"].values

    stimulated = (
        1.0 -
        np.exp(
            -H * nu0 / (KB * T)
        )
    )

    delta_nu = doppler_width(
        nu0,
        T
    )

    alpha0 = (
        np.sqrt(np.pi) *
        EE**2 /
        (ME * C) *
        f_lu *
        n_lower *
        stimulated /
        delta_nu
    )

    return alpha0, n_lower


#transfer grid
def prepare_transfer_grid(atm):

    out = atm.copy()

    tau = 10**out["lgTauR"].values

    idx = np.argsort(tau)

    out = out.iloc[
        idx
    ].reset_index(drop=True)

    tau = tau[idx]

    depth = out["Depth_cm"].values

    dtau = np.gradient(tau)
    ddepth = np.gradient(depth)

    alpha_R = np.abs(
        dtau /
        np.maximum(
            np.abs(ddepth),
            1e-30
        )
    )

    finite_alpha = alpha_R[
        np.isfinite(alpha_R)
    ]

    alpha_R = np.maximum(
        alpha_R,
        np.nanpercentile(
            finite_alpha,
            1
        ) * 1e-6
    )

    out["tau_R"] = tau
    out["alpha_R_cm-1"] = alpha_R

    return out


#planck function
def planck_lambda(
    wavelength_cm,
    T
):

    a = 2.0 * H * C**2

    b = (
        H * C /
        (
            wavelength_cm *
            KB *
            T
        )
    )

    return (
        a /
        (
            wavelength_cm**5 *
            (
                np.exp(b) - 1.0
            )
        )
    )


#formal transfer
def formal_lte_flux_lambda(
    wavelength_cm,
    tau_nu,
    T,
    mu_nodes,
    mu_weights
):

    tau_nu = np.asarray(
        tau_nu,
        dtype=float
    )

    T = np.asarray(
        T,
        dtype=float
    )

    B = planck_lambda(
        wavelength_cm,
        T
    )

    order = np.argsort(tau_nu)

    tau_nu = tau_nu[order]
    B = B[order]

    tau_nu = np.maximum.accumulate(
        tau_nu
    )

    dtau = np.diff(tau_nu)

    tau_mid = (
        0.5 *
        (
            tau_nu[1:] +
            tau_nu[:-1]
        )
    )

    B_mid = (
        0.5 *
        (
            B[1:] +
            B[:-1]
        )
    )

    I_mu = []

    for mu in mu_nodes:

        integrand = (
            B_mid *
            np.exp(
                -tau_mid / mu
            ) /
            mu
        )

        I_mu.append(
            np.sum(
                integrand *
                dtau
            )
        )

    I_mu = np.asarray(
        I_mu
    )

    return (
        2.0 *
        np.pi *
        np.sum(
            I_mu *
            mu_nodes *
            mu_weights
        )
    )


#synthetic line profile
def synthetic_line_profile(
    atm,
    species,
    wavelength_nm,
    loggf,
    Ei_cm1,
    g_lower,
    v_window_kms=30,
    n_points=1201,
    resolving_power=115000
):

    atm = prepare_transfer_grid(
        atm
    )

    lam0_cm = (
        wavelength_nm *
        1e-7
    )

    nu0 = C / lam0_cm

    velocity = np.linspace(
        -v_window_kms,
        v_window_kms,
        n_points
    )

    nu = (
        nu0 *
        (
            1.0 -
            velocity *
            1e5 /
            C
        )
    )

    alpha_line, n_lower = line_opacity(
        atm,
        species,
        wavelength_nm,
        loggf,
        Ei_cm1,
        g_lower
    )

    alpha_R = np.maximum(
        atm["alpha_R_cm-1"].values,
        1e-30
    )

    tau_R = atm["tau_R"].values
    T = atm["T_K"].values

    M_FE = (
        55.845 *
        1.66053906660e-24
    )

    delta_nu = (
        nu0 /
        C *
        np.sqrt(
            2.0 *
            KB *
            T /
            M_FE
        )
    )

    x, w = np.polynomial.legendre.leggauss(5)

    mu_nodes = 0.5 * (
        x + 1.0
    )

    mu_weights = 0.5 * w

    flux_line = []

    tau_cont = tau_R.copy()

    F_cont = formal_lte_flux_lambda(
        lam0_cm,
        tau_cont,
        T,
        mu_nodes,
        mu_weights
    )

    for nu_i in nu:

        profile_factor = np.exp(
            -(
                (
                    nu_i - nu0
                ) /
                delta_nu
            )**2
        )

        eta_phi = (
            alpha_line /
            alpha_R *
            profile_factor
        )

        integrand = (
            1.0 +
            eta_phi
        )

        tau_nu = np.zeros_like(
            tau_R
        )

        dtau_R = np.diff(
            tau_R
        )

        tau_nu[1:] = np.cumsum(
            0.5 *
            (
                integrand[1:] +
                integrand[:-1]
            ) *
            dtau_R
        )

        F_line = formal_lte_flux_lambda(
            C / nu_i,
            tau_nu,
            T,
            mu_nodes,
            mu_weights
        )

        flux_line.append(
            F_line
        )

    flux_line = np.asarray(
        flux_line
    )

    normalized_flux = (
        flux_line /
        F_cont
    )

    wavelength_nm_array = (
        C / nu
    ) * 1e7

    order = np.argsort(
        wavelength_nm_array
    )

    wavelength_nm_array = (
        wavelength_nm_array[order]
    )

    normalized_flux = (
        normalized_flux[order]
    )

    if (
        resolving_power is not None and
        resolving_power > 0
    ):

        dlambda = np.median(
            np.diff(
                wavelength_nm_array
            )
        )

        fwhm_nm = (
            wavelength_nm /
            resolving_power
        )

        sigma_nm = (
            fwhm_nm /
            (
                2.0 *
                np.sqrt(
                    2.0 *
                    np.log(2.0)
                )
            )
        )

        sigma_pix = (
            sigma_nm /
            max(
                abs(dlambda),
                1e-12
            )
        )

        if sigma_pix > 0.5:

            half = int(
                np.ceil(
                    5.0 *
                    sigma_pix
                )
            )

            grid = np.arange(
                -half,
                half + 1
            )

            kernel = np.exp(
                -0.5 *
                (
                    grid /
                    sigma_pix
                )**2
            )

            kernel /= kernel.sum()

            normalized_flux = np.convolve(
                normalized_flux,
                kernel,
                mode="same"
            )

    return (
        wavelength_nm_array,
        normalized_flux,
        n_lower
    )


