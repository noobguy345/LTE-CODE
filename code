#observed equivalent width
def measure_observed_ew(
    wave_nm,
    flux,
    center_nm,
    half_window_nm=0.04,
    continuum_inner=0.025,
    continuum_outer=0.040
):

    left = (
        center_nm -
        half_window_nm
    )

    right = (
        center_nm +
        half_window_nm
    )

    mask = (
        (wave_nm >= left) &
        (wave_nm <= right)
    )

    if np.sum(mask) < 10:
        return np.nan, None, None

    w = wave_nm[mask]
    f = flux[mask]

    cont_mask = (
        (
            (w >= center_nm - continuum_outer) &
            (w <= center_nm - continuum_inner)
        )
        |
        (
            (w >= center_nm + continuum_inner) &
            (w <= center_nm + continuum_outer)
        )
    )

    if np.sum(cont_mask) < 4:
        return np.nan, None, None

    continuum = np.median(
        f[cont_mask]
    )

    fn = (
        f /
        continuum
    )

    ew_nm = np.trapz(
        np.clip(
            1.0 - fn,
            0,
            None
        ),
        w
    )

    ew_mA = (
        ew_nm *
        1e4
    )

    return (
        ew_mA,
        w,
        fn
    )


